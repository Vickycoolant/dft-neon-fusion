# SPA fallback for Apache (required when hosting the built `dist/` on Apache,
# e.g. dftconsult.com on Google Cloud). Without this, direct visits to
# client-side routes like /admin/login return 404.
#
# Requirements on the server:
#   1. mod_rewrite enabled:   sudo a2enmod rewrite && sudo systemctl restart apache2
#   2. AllowOverride All set for the site's DocumentRoot in the vhost config.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html so React Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>

# Sensible cache headers for hashed assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
